# Copy to .env.local for the emulators; .env.<project-id> for production values.
ADMIN_USERNAME=churchadmin
PUBLIC_SITE_URL=http://localhost:3000/
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5021,http://localhost:5021
# Set to true only for local emulators / the local Express server.
LOCAL_DEVELOPMENT=true

# Gallery is off unless explicitly enabled. For an isolated local gallery,
# run npm run gallery:local at the repository root instead of editing this file.
GALLERY_ENABLED=false
# Production only, after the Cloudflare account review:
# GALLERY_WORKER_URL=https://your-reviewed-worker.workers.dev
# GALLERY_BILLING_START=<actual UTC billing-period start>
# GALLERY_BILLING_END=<actual UTC billing-period end>
# GALLERY_FREE_PLAN_VERIFIED=true
# GALLERY_TURNSTILE_SITE_KEY=<public site key>
# GALLERY_TICKET_SECRET, GALLERY_INTERNAL_SECRET, GALLERY_CLAIM_SECRET and
# GALLERY_TURNSTILE_SECRET belong in Secret Manager, never this file.
